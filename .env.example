# Optional FRED API key. The default pipeline uses FRED public CSV endpoints and does not require a key.
FRED_API_KEY=your_fred_key_here

# Optional future paid fundamentals key, not required for the current free SEC route.
FMP_API_KEY=your_fmp_key_here

# Required for polite SEC EDGAR automated access. Use a real contact email.
SEC_USER_AGENT="EconomicBubbleDashboard/1.0 your.email@example.com"

# SEC fair access is 10 requests/second max; this project defaults much slower.
SEC_REQUEST_PAUSE_SECONDS=0.25
